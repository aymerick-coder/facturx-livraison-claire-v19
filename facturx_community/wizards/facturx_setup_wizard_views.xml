<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_facturx_setup_wizard_form" model="ir.ui.view">
        <field name="name">facturx.setup.wizard.form</field>
        <field name="model">facturx.setup.wizard</field>
        <field name="arch" type="xml">
            <form string="Assistant facturation électronique — 1ère installation" delete="false">
                <sheet>
                    <div class="oe_title">
                        <h1>Bienvenue 👋</h1>
                        <p class="text-muted">
                            En 4 informations, vous êtes prêt pour la
                            facturation électronique B2B France réforme 2026.
                        </p>
                    </div>
                    <group>
                        <field name="company_id" invisible="1"/>
                        <field name="company_name" readonly="1"/>
                    </group>
                    <group string="📇 Identifiants société">
                        <field name="company_siret"
                               placeholder="14 chiffres, ex: 10526703300014"/>
                        <field name="company_vat"
                               placeholder="ex: FR12345678901"/>
                    </group>
                    <group string="🏦 Compte bancaire (optionnel)">
                        <field name="company_iban"
                               placeholder="ex: FR76 1234 5678 9012 3456 7890 123"/>
                    </group>
                    <group string="🎯 Format par défaut">
                        <field name="facturx_profile" widget="radio"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <strong>💡 Conseil :</strong>
                        Le format standard européen est recommandé pour une
                        conformité maximale avec la réforme 2026. Vous pourrez
                        changer à tout moment dans la configuration.
                    </div>
                </sheet>
                <footer>
                    <button name="action_save_and_finish"
                            string="🚀 Démarrer"
                            type="object" class="btn-primary"/>
                    <button string="Plus tard" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_facturx_setup_wizard" model="ir.actions.act_window">
        <field name="name">Assistant facturation électronique (1ère installation)</field>
        <field name="res_model">facturx.setup.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
