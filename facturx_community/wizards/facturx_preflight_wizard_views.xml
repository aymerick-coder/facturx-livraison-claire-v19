<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_facturx_preflight_wizard_form" model="ir.ui.view">
        <field name="name">facturx.preflight.wizard.form</field>
        <field name="model">facturx.preflight.wizard</field>
        <field name="arch" type="xml">
            <form string="Vérification avant transmission" delete="false">
                <sheet>
                    <div class="oe_title">
                        <h1>🛫 Vérification avant transmission</h1>
                        <p class="text-muted">
                            Test complet de la chaîne de génération avant la 1ère
                            facture en production. Cliquez sur « Lancer le test »
                            puis vérifiez chaque ligne ci-dessous.
                        </p>
                    </div>
                    <group>
                        <field name="company_id"/>
                        <field name="overall_status" widget="badge"
                               decoration-success="overall_status == 'ok'"
                               decoration-warning="overall_status == 'warning'"
                               decoration-danger="overall_status == 'blocked'"
                               decoration-muted="overall_status == 'not_run'"/>
                    </group>
                    <field name="result_html" widget="html" readonly="1"
                           invisible="overall_status == 'not_run'"/>
                </sheet>
                <footer>
                    <button name="action_run_preflight" type="object"
                            string="🚀 Lancer le test complet"
                            class="btn-primary"
                            invisible="overall_status != 'not_run'"/>
                    <button name="action_run_preflight" type="object"
                            string="🔄 Relancer le test"
                            class="btn-secondary"
                            invisible="overall_status == 'not_run'"/>
                    <button string="Fermer" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_facturx_preflight_wizard" model="ir.actions.act_window">
        <field name="name">Vérification avant transmission</field>
        <field name="res_model">facturx.preflight.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
