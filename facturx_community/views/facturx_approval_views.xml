<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Extension de la fiche société : config workflow approbation -->
    <record id="view_company_form_approval" model="ir.ui.view">
        <field name="name">res.company.form.facturx.approval</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="facturx_community.view_company_form_facturx"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='facturx_info']" position="after">
                <group string="Workflow approbation factures électroniques" name="facturx_approval_info">
                    <field name="facturx_approval_enabled" widget="boolean_toggle"/>
                    <field name="facturx_approval_l1_user_ids"
                           widget="many2many_tags"
                           invisible="not facturx_approval_enabled"/>
                    <field name="facturx_approval_l2_user_ids"
                           widget="many2many_tags"
                           invisible="not facturx_approval_enabled"/>
                    <field name="facturx_approval_l2_threshold"
                           invisible="not facturx_approval_enabled"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Extension de la facture : statusbar + boutons approbation -->
    <record id="view_move_form_facturx_approval" model="ir.ui.view">
        <field name="name">account.move.form.facturx.approval</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_facturx_approve_l1"
                        string="✅ Approuver L1"
                        type="object" class="btn-success"
                        invisible="facturx_approval_state != 'pending_l1'"/>
                <button name="action_facturx_approve_l2"
                        string="✅ Approuver L2"
                        type="object" class="btn-success"
                        invisible="facturx_approval_state != 'pending_l2'"/>
                <button name="action_facturx_reject"
                        string="❌ Refuser"
                        type="object" class="btn-danger"
                        invisible="facturx_approval_state not in ('pending_l1', 'pending_l2')"
                        confirm="Refuser cette facture ? Renseignez le motif de refus avant."/>
                <field name="facturx_approval_state" widget="statusbar"
                       statusbar_visible="pending_l1,pending_l2,approved"
                       invisible="facturx_approval_state == 'not_required'"/>
            </xpath>

            <!-- Ajouter le motif de refus dans l'onglet Factur-X -->
            <xpath expr="//page[@name='facturx_tab']" position="inside">
                <separator string="Approbation"
                           invisible="facturx_approval_state == 'not_required'"/>
                <group invisible="facturx_approval_state == 'not_required'">
                    <group>
                        <field name="facturx_approval_l1_user_id" readonly="1"/>
                        <field name="facturx_approval_l1_date" readonly="1"/>
                        <field name="facturx_approval_l2_user_id" readonly="1"/>
                        <field name="facturx_approval_l2_date" readonly="1"/>
                    </group>
                    <group>
                        <field name="facturx_approval_rejection_reason"
                               placeholder="Motif (obligatoire si refus)"
                               invisible="facturx_approval_state == 'approved'"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
