<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =========================================================
         POINT 8 — Centre anomalies Factur-X v1
         =========================================================
         Vue dédiée pour les factures ayant un problème Factur-X.
         Pas de modèle persistant nouveau : on filtre account.move
         sur facturx_has_anomaly = True et on affiche les colonnes
         orientées action (cause probable + bouton "Marquer résolu"
         + bouton "Réessayer la génération").
         ========================================================= -->

    <record id="view_facturx_anomaly_center_list" model="ir.ui.view">
        <field name="name">account.move.list.facturx.anomaly_center</field>
        <field name="model">account.move</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="Factures à corriger"
                  create="false" delete="false" edit="false"
                  default_order="facturx_lifecycle_last_event_date desc, id desc"
                  decoration-danger="facturx_lifecycle_state in ('in_anomaly','rejected')"
                  decoration-warning="facturx_lifecycle_state in ('on_hold','in_dispute')">
                <field name="name" string="N° facture"/>
                <field name="invoice_date" string="Date" optional="show"/>
                <field name="partner_id" string="Client / Fournisseur"/>
                <field name="amount_total_signed" string="Montant"
                       sum="Total" widget="monetary"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="facturx_lifecycle_state" string="État"
                       widget="badge"
                       decoration-danger="facturx_lifecycle_state in ('in_anomaly','rejected')"
                       decoration-warning="facturx_lifecycle_state in ('on_hold','in_dispute')"
                       decoration-info="facturx_lifecycle_state in ('sent','delivered','read','ready')"
                       decoration-muted="facturx_lifecycle_state in ('draft','archived')"/>
                <field name="facturx_conformity_status" string="Conformité"
                       widget="badge"
                       decoration-success="facturx_conformity_status == 'ready'"
                       decoration-warning="facturx_conformity_status == 'warning'"
                       decoration-danger="facturx_conformity_status == 'blocked'"
                       optional="show"/>
                <field name="facturx_conformity_score" string="Score"
                       optional="hide"/>
                <field name="facturx_anomaly_cause" string="Cause probable"/>
                <field name="facturx_anomaly_recommended_action"
                       string="Action recommandée" optional="show"/>
                <field name="facturx_lifecycle_last_event_date"
                       string="Dernière mise à jour" widget="datetime"
                       optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>

                <!-- Actions rapides inline (1 clic) -->
                <button name="action_facturx_retry_generation" type="object"
                        string="Relancer" icon="fa-refresh"
                        class="btn-link"
                        invisible="facturx_status != 'error'"/>
                <button name="action_facturx_mark_resolved" type="object"
                        string="Marquer résolu" icon="fa-check"
                        class="btn-link"/>

                <field name="facturx_has_anomaly" column_invisible="True"/>
                <field name="facturx_status" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_facturx_anomaly_center_search" model="ir.ui.view">
        <field name="name">account.move.search.facturx.anomaly_center</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <search string="Factures à corriger">
                <field name="name" string="N° facture"/>
                <field name="partner_id"/>
                <field name="facturx_anomaly_cause"/>
                <separator/>
                <filter string="Erreurs de génération XML"
                        name="filter_error"
                        domain="[('facturx_status','=','error')]"/>
                <filter string="Lifecycle en anomalie"
                        name="filter_in_anomaly"
                        domain="[('facturx_lifecycle_state','=','in_anomaly')]"/>
                <filter string="Refusées"
                        name="filter_rejected"
                        domain="[('facturx_lifecycle_state','=','rejected')]"/>
                <filter string="Bloquées par la validation amont"
                        name="filter_blocked"
                        domain="[('facturx_conformity_status','=','blocked')]"/>
                <separator/>
                <filter string="Dernière maj &gt; 48h"
                        name="filter_stale"
                        domain="[('facturx_lifecycle_last_event_date','&lt;',
                                  (context_today() - relativedelta(hours=48)).strftime('%Y-%m-%d %H:%M:%S'))]"/>
                <group expand="0" string="Regrouper par">
                    <filter string="Client / Fournisseur" name="group_partner"
                            context="{'group_by': 'partner_id'}"/>
                    <filter string="État lifecycle" name="group_state"
                            context="{'group_by': 'facturx_lifecycle_state'}"/>
                    <filter string="Conformité" name="group_conformity"
                            context="{'group_by': 'facturx_conformity_status'}"/>
                    <filter string="Société" name="group_company"
                            context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ==========================================================
         Action principale du Centre anomalies
         ========================================================== -->
    <record id="action_facturx_anomaly_center" model="ir.actions.act_window">
        <field name="name">Factures à corriger</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_facturx_anomaly_center_list"/>
        <field name="search_view_id" ref="view_facturx_anomaly_center_search"/>
        <field name="domain">[
            ('move_type', 'in', ('out_invoice','out_refund','in_invoice','in_refund')),
            ('facturx_status', '!=', 'none'),
            '|', '|', '|',
                ('facturx_lifecycle_state', 'in', ('in_anomaly', 'rejected')),
                ('facturx_conformity_status', '=', 'blocked'),
                ('facturx_status', '=', 'error'),
                ('facturx_has_anomaly', '=', True),
        ]</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune facture à corriger.
            </p>
            <p>
                Quand une facture rencontre un problème (erreur de préparation,
                refus de l'administration, contrôle de conformité bloquant), elle
                apparaît ici avec sa cause probable et l'action à entreprendre.
            </p>
        </field>
    </record>

    <!-- ==========================================================
         Menu Comptabilité → Anomalies Factur-X (sequence 6, juste après le Cockpit)
         ========================================================== -->
    <menuitem id="menu_facturx_anomaly_center"
              name="Factures à corriger"
              parent="account.menu_finance"
              action="action_facturx_anomaly_center"
              groups="account.group_account_invoice"
              sequence="6"/>

</odoo>
