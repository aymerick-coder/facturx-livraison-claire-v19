<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =========================================================
         POINT 2 — Timeline visuelle facture
         =========================================================
         Affiche l'historique du cycle de vie Factur-X directement
         sur la fiche facture, dans un onglet "Suivi" lisible par
         le COMPTABLE (pas réservé au groupe technique).

         Approche : list view embedded décorée + en-tête synthétique.
         Pas de composant Owl custom -> portabilité v13 → v19, code
         maintenable, idiomatique Odoo.
         ========================================================= -->

    <!-- Vue list embedded utilisée dans la One2many de la facture.
         Plus visuelle que la vue admin du Point 1 :
         - colonne "icône + libellé d'état" via widget badge
         - décoration ligne par sévérité
         - date relative en première colonne
         - acteur discret en muted -->
    <record id="view_facturx_lifecycle_event_embedded_list" model="ir.ui.view">
        <field name="name">facturx.lifecycle.event.embedded.list</field>
        <field name="model">facturx.lifecycle.event</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list string="Historique de traitement"
                  create="false" delete="false" edit="false"
                  default_order="event_date desc"
                  decoration-success="severity == 'success'"
                  decoration-info="severity == 'info'"
                  decoration-warning="severity == 'warning'"
                  decoration-danger="severity == 'danger'"
                  decoration-muted="severity == 'muted'">
                <field name="severity" column_invisible="True"/>
                <field name="icon_name" column_invisible="True"/>
                <field name="event_date" string="Date" widget="datetime"/>
                <field name="state_label" string="Étape"/>
                <field name="reason" string="Détail"/>
                <field name="actor" string="Origine" optional="show"/>
                <field name="user_id" string="Utilisateur" optional="hide"/>
                <field name="from_state" string="Provient de" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Onglet "Suivi facture électronique" sur la fiche facture.
         Visible POUR LE COMPTABLE (pas seulement le groupe technique).
         Apparaît dès qu'au moins 1 événement existe : pas de pollution
         sur les factures hors périmètre Factur-X. -->
    <record id="view_move_form_facturx_timeline" model="ir.ui.view">
        <field name="name">account.move.form.facturx.timeline</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">25</field>
        <field name="arch" type="xml">

            <!-- L'onglet Suivi est positionné AVANT l'onglet technique
                 (existant, groupe restreint) pour rester accessible au
                 comptable sans pour autant être imposé en première position. -->
            <xpath expr="//page[@id='other_tab']" position="after">
                <page string="Historique de l'envoi"
                      name="facturx_timeline_tab"
                      invisible="facturx_lifecycle_event_count == 0">

                    <!-- En-tête synthétique : état courant en gros,
                         dernière mise à jour, compteur d'étapes. -->
                    <div class="o_horizontal_separator mb-3">
                        <div class="row align-items-center">
                            <div class="col-md-6">
                                <span class="text-muted">État actuel :</span>
                                <field name="facturx_lifecycle_state"
                                       widget="badge"
                                       decoration-success="facturx_lifecycle_state in ('accepted','paid')"
                                       decoration-info="facturx_lifecycle_state in ('sent','delivered','read','ready')"
                                       decoration-warning="facturx_lifecycle_state in ('in_dispute','on_hold')"
                                       decoration-danger="facturx_lifecycle_state in ('rejected','in_anomaly')"
                                       decoration-muted="facturx_lifecycle_state in ('draft','archived')"
                                       class="ms-2"/>
                            </div>
                            <div class="col-md-6 text-md-end text-muted small">
                                <span invisible="not facturx_lifecycle_last_event_date">
                                    Dernière mise à jour :
                                    <field name="facturx_lifecycle_last_event_date"
                                           widget="datetime"
                                           class="ms-1"/>
                                </span>
                                <span class="ms-3">
                                    <field name="facturx_lifecycle_event_count"/>
                                    étape<span invisible="facturx_lifecycle_event_count &lt;= 1">s</span>
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Mini-légende discrète (visible uniquement quand l'onglet
                         est ouvert, donc faible coût d'attention).
                         Pédagogie pour le comptable : il sait immédiatement
                         quoi attendre côté couleur sans devoir lire de doc. -->
                    <div class="alert alert-light border d-flex flex-wrap gap-3 small mb-3" role="status">
                        <span><i class="fa fa-circle text-success me-1"/>Validée et payée</span>
                        <span><i class="fa fa-circle text-info me-1"/>Transmission en cours</span>
                        <span><i class="fa fa-circle text-warning me-1"/>À surveiller</span>
                        <span><i class="fa fa-circle text-danger me-1"/>Refusée par l'administration</span>
                        <span><i class="fa fa-circle text-muted me-1"/>Brouillon</span>
                    </div>

                    <!-- Timeline elle-même : la One2many des événements
                         lifecycle de la facture, rendue par la vue
                         "embedded.list" définie au-dessus.
                         readonly="1" pour interdire l'édition manuelle :
                         la timeline est append-only, pilotée par les
                         transitions (intégrité audit). -->
                    <field name="facturx_lifecycle_event_ids"
                           nolabel="1"
                           readonly="1"
                           context="{'list_view_ref': 'facturx_community.view_facturx_lifecycle_event_embedded_list'}"/>

                    <!-- Note de bas de page : explication métier minimale.
                         Cohérent avec la philosophie "intégrateur LCSX" :
                         tout est lisible sans formation. -->
                    <div class="text-muted small mt-3">
                        <i class="fa fa-info-circle me-1"/>
                        Cette timeline est mise à jour automatiquement à chaque
                        étape du cycle de vie de votre facture électronique
                        (génération, envoi, accusé de réception, acceptation,
                        paiement…). Elle ne peut pas être modifiée manuellement
                        pour garantir la piste d'audit fiable.
                    </div>

                </page>
            </xpath>
        </field>
    </record>

</odoo>
