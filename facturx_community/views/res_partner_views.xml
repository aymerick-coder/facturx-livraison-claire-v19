<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_partner_form_facturx" model="ir.ui.view">
        <field name="name">res.partner.form.facturx</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Retour Claire 08/06 : Code service + EJ Chorus Pro doivent
                 etre AU NIVEAU FACTURE uniquement, PAS sur la fiche partner.
                 Les champs restent dans le model res_partner pour autofill
                 futur eventuel, mais ne sont plus exposes en UI. -->
            <xpath expr="//field[@name='vat']" position="after">
                <field name="siret"/>
            </xpath>
        </field>
    </record>

</odoo>
