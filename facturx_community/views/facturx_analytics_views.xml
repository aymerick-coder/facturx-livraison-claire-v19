<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_facturx_analytics_report_form" model="ir.ui.view">
        <field name="name">facturx.analytics.report.form</field>
        <field name="model">facturx.analytics.report</field>
        <field name="arch" type="xml">
            <form string="Analyse des données" create="false" edit="true" delete="false" duplicate="false">
                <sheet>
                    <div class="oe_title">
                        <h1>Analyse des données</h1>
                    </div>
                    <group>
                        <group string="Période">
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Synthèse">
                            <field name="total_invoices"/>
                            <field name="total_amount_ht" widget="monetary"/>
                            <field name="total_amount_ttc" widget="monetary"/>
                            <field name="success_rate" widget="percentage"/>
                            <field name="error_count"
                                   decoration-danger="error_count &gt; 0"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Par format" name="by_profile">
                            <field name="by_profile" widget="html" readonly="1"/>
                        </page>
                        <page string="Par catégorie TVA" name="by_vat_category">
                            <field name="by_vat_category" widget="html" readonly="1"/>
                        </page>
                        <page string="Top 10 clients" name="top_customers">
                            <field name="top_customers" widget="html" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button string="Fermer" class="btn-primary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_facturx_analytics_report" model="ir.actions.act_window">
        <field name="name">Analyse des données</field>
        <field name="res_model">facturx.analytics.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
