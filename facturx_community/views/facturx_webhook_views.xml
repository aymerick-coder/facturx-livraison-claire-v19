<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_facturx_webhook_tree" model="ir.ui.view">
        <field name="name">facturx.webhook.tree</field>
        <field name="model">facturx.webhook</field>
        <field name="arch" type="xml">
            <list string="Notifications automatiques"
                  decoration-muted="not active"
                  decoration-danger="failed_count >= 5">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="url"/>
                <field name="event_filter"/>
                <field name="last_called_at"/>
                <field name="last_status_code"/>
                <field name="failed_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_facturx_webhook_form" model="ir.ui.view">
        <field name="name">facturx.webhook.form</field>
        <field name="model">facturx.webhook</field>
        <field name="arch" type="xml">
            <form string="Notification automatique" delete="false">
                <header>
                    <button name="action_test_webhook" type="object"
                            string="🧪 Tester l'URL"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="url" placeholder="https://votre-erp.com/api/factures"/>
                        <field name="event_filter"/>
                        <field name="active"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group string="Sécurité HMAC SHA-256">
                        <field name="secret" widget="char_password"/>
                        <p class="text-muted">
                            Le destinataire doit recalculer
                            <code>HMAC_SHA256(secret, body)</code> et le comparer à
                            <code>X-Facturx-Signature</code>.
                        </p>
                    </group>
                    <group string="Diagnostic">
                        <field name="last_called_at"/>
                        <field name="last_status_code"/>
                        <field name="failed_count"/>
                        <field name="last_response" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_facturx_webhook" model="ir.actions.act_window">
        <field name="name">Notifications automatiques</field>
        <field name="res_model">facturx.webhook</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
