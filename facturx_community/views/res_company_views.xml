<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_company_form_facturx" model="ir.ui.view">
        <field name="name">res.company.form.facturx</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='social_media']" position="before">
                <group string="Factur-X / Facturation Électronique" name="facturx_info">
                    <!-- FIX 26/06 (retour Claire HANZO / Logitud) : on affiche le
                         champ NATIF Odoo `company_registry` (= SIRET en France)
                         au lieu de notre ancien champ custom `siret`. Plus de
                         doublon de donnée : tout le code lit company_registry. -->
                    <field name="company_registry" string="SIRET"
                           placeholder="14 chiffres (SIREN + NIC)"/>
                    <field name="siren" readonly="1"/>
                    <field name="nic" readonly="1"/>
                    <field name="naf_code"/>
                    <field name="rcs_city"/>
                    <field name="capital_amount"/>
                    <field name="facturx_profile"/>
                    <field name="facturx_tva_debits"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
