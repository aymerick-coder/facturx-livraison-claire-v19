<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Add Factur-X operation type to the product form -->
    <record id="view_product_template_form_facturx" model="ir.ui.view">
        <field name="name">product.template.form.facturx</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="inside">
                <group string="Factur-X / Réforme 2026" name="facturx_group">
                    <field name="facturx_operation_type"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
