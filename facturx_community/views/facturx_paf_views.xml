<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_facturx_paf_compliance_form" model="ir.ui.view">
        <field name="name">facturx.paf.compliance.form</field>
        <field name="model">facturx.paf.compliance</field>
        <field name="arch" type="xml">
            <form string="Contrôle de conformité" create="false" delete="false" duplicate="false">
                <sheet>
                    <div class="oe_title">
                        <h1>🛡️ Contrôle de conformité</h1>
                        <h3>(Piste d'Audit Fiable — article L102 B CGI)</h3>
                    </div>
                    <group>
                        <group>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                            <field name="paf_score"
                                   widget="percentpie"
                                   string="Note de conformité / 100"
                                   help="Indicateur de la qualité de vos paramètres pour la facturation électronique."/>
                            <field name="paf_status" widget="badge"
                                   decoration-success="paf_status == 'conforme'"
                                   decoration-warning="paf_status == 'partiel'"
                                   decoration-danger="paf_status == 'non_conforme'"/>
                        </group>
                        <group string="Checklist">
                            <field name="check_pdf_archived" widget="boolean_toggle" readonly="1"/>
                            <field name="check_hash_integrity" widget="boolean_toggle" readonly="1"/>
                            <field name="check_tsa_horodatage" widget="boolean_toggle" readonly="1"/>
                            <field name="check_retention_10ans" widget="boolean_toggle" readonly="1"/>
                            <field name="check_link_invoice_pdf" widget="boolean_toggle" readonly="1"/>
                        </group>
                    </group>
                    <separator string="Recommandations"/>
                    <field name="recommendations" widget="html" readonly="1"/>
                    <!-- Boutons d'action corrective directs (visibles UNIQUEMENT
                         si le check correspondant est encore à FAUX). -->
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        <button name="action_archive_all_eligible"
                                type="object"
                                string="🗂️ Archiver les factures maintenant"
                                class="btn-primary"
                                invisible="check_pdf_archived"/>
                        <button name="action_verify_all_archives"
                                type="object"
                                string="✓ Vérifier toutes les archives"
                                class="btn-primary"
                                invisible="check_hash_integrity"/>
                        <button name="action_open_tsa_config"
                                type="object"
                                string="🕒 Configurer le service TSA"
                                class="btn-primary"
                                invisible="check_tsa_horodatage"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Mini wizard de configuration du service TSA -->
    <record id="view_facturx_tsa_config_wizard_form" model="ir.ui.view">
        <field name="name">facturx.tsa.config.wizard.form</field>
        <field name="model">facturx.tsa.config.wizard</field>
        <field name="arch" type="xml">
            <form string="Activer l'horodatage légal de vos archives" delete="false">
                <sheet>
                    <div class="oe_title">
                        <h1>🕒 Activer l'horodatage légal de vos archives</h1>
                    </div>

                    <div class="alert alert-info" role="alert">
                        <strong>Pour démarrer simplement&#160;:</strong>
                        laissez le champ tel quel et cliquez sur
                        <strong>« 💾 Enregistrer »</strong>. C'est tout.
                        <br/>
                        Le service gratuit <strong>FreeTSA</strong> est
                        pré-rempli&#160;: il suffit pour rendre vos archives
                        conformes à la <em>Piste d'Audit Fiable</em>
                        (article L102 B du CGI).
                    </div>

                    <separator string="À quoi ça sert ?"/>
                    <p>
                        Quand vous archivez une facture, le module appose
                        dessus un <strong>cachet daté électronique</strong>
                        délivré par un tiers de confiance.
                        Ce cachet prouve que la facture existait bien à
                        cette date — comme un cachet de la poste.
                        L'administration fiscale l'exige pour les factures
                        conservées sous forme électronique.
                    </p>

                    <separator string="Service à utiliser"/>
                    <group>
                        <field name="tsa_url"
                               string="Service d'horodatage"
                               placeholder="https://freetsa.org/tsr"/>
                    </group>

                    <separator string="Vous avez déjà un contrat ailleurs ?"/>
                    <field name="suggested_providers" widget="html" readonly="1"/>
                </sheet>
                <footer>
                    <button name="action_save"
                            type="object"
                            string="💾 Enregistrer"
                            class="btn-primary"/>
                    <button string="Annuler"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action serveur : recupere ou cree le singleton de conformite
         pour la societe courante puis ouvre la vue form sur ce record.
         Necessaire car les compute store=False ne se declenchent pas
         sur un NewId ouvert via act_window classique. -->
    <record id="action_facturx_paf_compliance" model="ir.actions.server">
        <field name="name">Contrôle de conformité</field>
        <field name="model_id" ref="model_facturx_paf_compliance"/>
        <field name="state">code</field>
        <field name="code">action = env['facturx.paf.compliance'].action_open_compliance()</field>
    </record>

    <!-- Cabinet cockpit -->
    <record id="view_facturx_cabinet_cockpit_form" model="ir.ui.view">
        <field name="name">facturx.cabinet.cockpit.form</field>
        <field name="model">facturx.cabinet.cockpit</field>
        <field name="arch" type="xml">
            <form string="Tableau de bord du cabinet" create="false" edit="false" delete="false" duplicate="false">
                <sheet>
                    <div class="oe_title">
                        <h1>🏢 Tableau de bord du cabinet</h1>
                        <h3>Vue consolidée multi-clients</h3>
                    </div>
                    <group>
                        <group string="Synthèse globale">
                            <field name="total_companies"/>
                            <field name="total_invoices_month"/>
                            <field name="total_invoices_error"
                                   decoration-danger="total_invoices_error &gt; 0"/>
                            <field name="avg_compliance_score" widget="percentage"/>
                        </group>
                    </group>
                    <separator string="Détail par société"/>
                    <field name="companies_summary" widget="html" readonly="1"/>
                </sheet>
                <footer>
                    <button string="Fermer" class="btn-primary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_facturx_cabinet_cockpit_srv" model="ir.actions.server">
        <field name="name">Tableau de bord du cabinet</field>
        <field name="model_id" ref="model_facturx_cabinet_cockpit"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_cockpit()</field>
    </record>

</odoo>
