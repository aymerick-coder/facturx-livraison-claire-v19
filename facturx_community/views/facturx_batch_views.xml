<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Actions de masse Factur-X (Point 4 v2.5) -->
    <record id="action_facturx_batch_generate" model="ir.actions.server">
        <field name="name">Factur-X : Générer PDF en série</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
if records:
    action = records.action_facturx_batch_generate()
        </field>
    </record>

    <record id="action_facturx_batch_mark_sent" model="ir.actions.server">
        <field name="name">Factur-X : Marquer comme envoyées</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
if records:
    action = records.action_facturx_batch_mark_sent()
        </field>
    </record>

    <record id="action_facturx_batch_export_zip" model="ir.actions.server">
        <field name="name">Factur-X : Exporter en ZIP (PDF + XML)</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
if records:
    action = records.action_facturx_batch_export_zip()
        </field>
    </record>

</odoo>
