<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Extend invoice report to add Factur-X legal mentions -->
    <template id="report_invoice_facturx_legal" inherit_id="account.report_invoice_document">
        <xpath expr="//div[@id='informations']" position="inside">
            <div t-if="o.company_id.siret" class="col-auto col-3 mw-100 mb-2">
                <strong>SIRET:</strong>
                <p class="m-0" t-field="o.company_id.siret"/>
            </div>
            <div t-if="o.company_id.naf_code" class="col-auto col-3 mw-100 mb-2">
                <strong>NAF:</strong>
                <p class="m-0" t-field="o.company_id.naf_code"/>
            </div>
        </xpath>
    </template>
</odoo>
